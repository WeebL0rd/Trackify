# Copia este archivo como .env y rellena tus credenciales.

# Clave secreta de la cuenta Stellar Testnet (empieza con S...)
# Genera una cuenta gratis en: https://stellar.org/laboratory/#account-creator?network=testnet
STELLAR_SECRET_KEY=

# Frontend (Vite) — variables expuestas al browser, solo lectura
VITE_CONTRACT_ID=              # Contract ID del contrato Soroban (empieza con C...)
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_SIM_ACCOUNT=      # Public key usada para simular (empieza con G..., NO es el secret)
